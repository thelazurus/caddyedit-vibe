# Torrent
torrent.lazurus.me {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    # --- rTorrent RPC for nzb360 (no SSO, basic auth handled by rflood) ---
 #   @rpc path /rpc2 /RPC2
 #   handle @rpc {
 #       # If nzb360 calls /rpc2, make sure upstream sees /RPC2
 #       uri replace /rpc2 /RPC2
 #       import sso-bypass-basic http://192.168.0.171:5000
 #   }

    # --- Everything else (Flood UI) behind your SSO/bypass snippet ---
    handle {
        import sso-bypass http://192.168.0.171:8080
    }
}
