# Do not import directly, use core sso or other methods below
# Authelia forward auth (replaces the Authentik outpost block)
(ssoauth) {
    forward_auth http://authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        trusted_proxies private_ranges
    }
}

# Core SSO: Authentik → upstream
# Usage: import sso-core <upstream>
(sso-core) {
    route {
        handle {
            import ssoauth
            reverse_proxy {args[0]}
        }
    }
}

# Core SSO + fixed Basic auth upstream
# Usage: import sso-core-basic <upstream>
#
# Requires:
#   GENERIC_BASIC_AUTH = "Basic <base64(user:pass)>"
#
(sso-core-basic) {
    route {
        handle {
            import ssoauth
            reverse_proxy {args[0]} {
                header_up Authorization "{env.GENERIC_BASIC_AUTH}"
            }
        }
    }
}

# Bypass + SSO (no Basic)
# Usage: import sso-bypass <upstream>
(sso-bypass) {
    @nzb360 header X-NZB360-Key "{env.SSO_BYPASS_KEY}"

    route {
        # 1) Bypass → straight to upstream
        handle @nzb360 {
            header -X-NZB360-Key
            reverse_proxy {args[0]}
        }

        # 2) Everyone else → core SSO
        handle {
            import sso-core {args[0]}
        }
    }
}

# Bypass + SSO + Basic
# Usage: import sso-bypass-basic <upstream>
#
# Same GENERIC_BASIC_AUTH env as sso-core-basic
#
(sso-bypass-basic) {
    @nzb360 header X-NZB360-Key "{env.SSO_BYPASS_KEY}"

    route {
        # 1) Bypass → straight to upstream with Basic
        handle @nzb360 {
            header -X-NZB360-Key
            reverse_proxy {args[0]} {
                header_up Authorization "{env.GENERIC_BASIC_AUTH}"
            }
        }

        # 2) Everyone else → core SSO+Basic
        handle {
            import sso-core-basic {args[0]}
        }
    }
}

# Temporary redirect: corenlabs.dev → lazurus.me
*.corenlabs.dev, corenlabs.dev {
    @sub {
        not host corenlabs.dev
    }
    redir @sub https://{labels.2}.lazurus.me{uri} 302
    redir https://lazurus.me 302

    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

